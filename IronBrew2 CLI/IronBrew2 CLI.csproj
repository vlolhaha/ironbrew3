<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>IronBrew3</AssemblyName>
        <TargetFramework>netcoreapp3.1</TargetFramework>
        <RootNamespace>IronBrew3_CLI</RootNamespace>
        <LangVersion>8</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\IronBrew2\IronBrew2.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\Lua\**\*" Link="Lua\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

</Project>
